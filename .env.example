# Neon Postgres connection string (Neon dashboard → Connect). Use the pooled URL.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate a secret with: npx auth@latest secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app (used by Better Auth for callbacks and trusted origins)
BETTER_AUTH_URL="http://localhost:3000"
